{
    "$schema": "https://www.raycast.com/schemas/extension.json",
    "name": "quick-latex local",
    "title": "LaTeX to Image",
    "description": "Converts LaTeX text to image. Copy the image to the Clipboard.",
    "icon": "bird.png",
    "author": "Noamko",
    "contributors": [
        "FariaF22",
        "kosei_haruyama"
    ],
    "categories": [
        "Design Tools",
        "Web",
        "Data",
        "Productivity",
        "Finance",
        "Other"
    ],
    "license": "MIT",
    "preferences": [
        {
            "name": "preamble",
            "title": "Custom Preamble",
            "description": "LaTeX commands appended after the built-in amsmath and amssymb packages.",
            "type": "textfield",
            "required": false,
            "default": "",
            "placeholder": "\\usepackage{mathtools,bm,physics}"
        }
    ],
    "commands": [
        {
            "name": "quick-latex",
            "title": "Quick LaTeX",
            "subtitle": "Quick LaTeX",
            "description": "Quickly convert LaTeX to image and copy the image to the Clipboard.",
            "mode": "view",
            "arguments": [
                {
                    "name": "latex",
                    "type": "text",
                    "required": false,
                    "placeholder": "LaTeX"
                }
            ]
        }
    ],
    "dependencies": {
        "@raycast/api": "^1.104.23"
    },
    "devDependencies": {
        "@types/node": "^22.19.17",
        "@types/react": "^19.0.10",
        "@typescript-eslint/eslint-plugin": "^5.0.0",
        "@typescript-eslint/parser": "^5.0.0",
        "eslint": "^7.32.0",
        "eslint-config-prettier": "^8.3.0",
        "prettier": "^2.5.1",
        "typescript": "^5.9.3"
    },
    "scripts": {
        "build": "ray build -e dist",
        "dev": "ray develop",
        "fix-lint": "ray lint --fix",
        "lint": "ray lint"
    },
    "platforms": [
        "macOS"
    ]
}