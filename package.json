{
    "$schema": "https://www.raycast.com/schemas/extension.json",
    "name": "quick-math",
    "title": "Quick Math",
    "description": "Render LaTeX or Typst math locally and copy it as a transparent PNG.",
    "icon": "circular-integral.png",
    "author": "Noamko",
    "contributors": [
        "FariaF22",
        "kosei_haruyama"
    ],
    "categories": [
        "Design Tools",
        "Web",
        "Data",
        "Productivity",
        "Finance",
        "Other"
    ],
    "license": "MIT",
    "preferences": [
        {
            "name": "renderer",
            "title": "Rendering Engine",
            "description": "Choose the syntax and local renderer for your formulas.",
            "type": "dropdown",
            "required": false,
            "default": "latex",
            "data": [
                { "title": "LaTeX", "value": "latex" },
                { "title": "Typst", "value": "typst" }
            ]
        },
        {
            "name": "preamble",
            "title": "Custom Preamble",
            "description": "LaTeX commands appended after the built-in amsmath and amssymb packages.",
            "type": "textfield",
            "required": false,
            "default": "",
            "placeholder": "\\usepackage{mathtools,bm,physics}"
        }
    ],
    "commands": [
        {
            "name": "quick-math",
            "title": "Quick Math",
            "description": "Preview a LaTeX or Typst formula and copy it as a transparent PNG.",
            "mode": "view",
            "arguments": [
                {
                    "name": "latex",
                    "type": "text",
                    "required": false,
                    "placeholder": "Formula"
                }
            ]
        }
    ],
    "dependencies": {
        "@raycast/api": "^1.104.23"
    },
    "devDependencies": {
        "@types/node": "^22.19.17",
        "@types/react": "^19.0.10",
        "@typescript-eslint/eslint-plugin": "^5.0.0",
        "@typescript-eslint/parser": "^5.0.0",
        "eslint": "^7.32.0",
        "eslint-config-prettier": "^8.3.0",
        "prettier": "^2.5.1",
        "typescript": "^5.9.3"
    },
    "scripts": {
        "build": "ray build -e dist",
        "dev": "ray develop",
        "fix-lint": "ray lint --fix",
        "lint": "ray lint"
    },
    "platforms": [
        "macOS"
    ]
}
